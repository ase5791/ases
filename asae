RunService.Heartbeat:Connect(function()
    if not C.eggOn then return end
    if not lockedCFrame or not lockedTarget then return end
    if not lockedTarget.Parent then return end

    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if (root.Position - lockedCFrame.Position).Magnitude > 100 then
        clearAllLock()
        C.status = "重生位置过远"
        return
    end

    local curEggPos = gPos(lockedTarget)
    if curEggPos then
        if not lastEggPos or (curEggPos - lastEggPos).Magnitude > 0.5 then
            lastEggPos = curEggPos
            local cf, hv = computeStandCFrame(lockedTarget, currentAngle)
            if cf then
                lockedCFrame = cf
                if hv and not isHover then
                    isHover = true
                    pcall(function() root.Anchored = true end)
                elseif not hv and isHover then
                    isHover = false
                    pcall(function() root.Anchored = false end)
                end
            end
        end
    end

    if not isHover then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = lockedCFrame
        end)
    end
end)

