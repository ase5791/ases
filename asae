local lastJump = 0
task.spawn(function()
    while true do
        task.wait(0.1)
        pcall(function()
            if not C.jumpOn then return end
            if C.eggOn and C.busy then return end
            if tick() - lastJump < C.jumpInterval then return end
            local char = player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            if root.Anchored then return end
            pcall(function() hum.Jump = true end)
            task.wait(0.03)
            pcall(function() hum.Jump = false end)
            sendKeyDown(Enum.KeyCode.Space)
            task.wait(0.06)
            sendKeyUp(Enum.KeyCode.Space)
            lastJump = tick()
        end)
    end
end)

