-- ============================================================
-- 捡蛋主循环
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.05)
        pcall(function()
            if not C.eggOn then
                C.status = "捡蛋关闭"
                clearAllLock()
                return
            end
            if C.busy then return end
            if not GenFolder then C.status = "无GenFolder" return end

            local char = player.Character
            if not char then C.status = "无角色" return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then C.status = "等Humanoid" return end
            if hum.Health <= 0 then C.status = "死亡中" return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then C.status = "无root" return end

            local eggs = {}
            for _, obj in ipairs(GenFolder:GetChildren()) do
                if isEgg(obj) and gPos(obj) then table.insert(eggs, obj) end
            end
            if #eggs == 0 then C.status = "没蛋" return end

            local near, nd = nil, math.huge
            for _, e in ipairs(eggs) do
                local p = gPos(e)
                if p then
                    local d = (p - root.Position).Magnitude
                    if d < nd then nd, near = d, e end
                end
            end
            if not near then return end

            C.busy = true
            lockedTarget = near
            eggStartTime = tick()
            currentAngle = getInitialAngle(near)
            local cf, hv = computeStandCFrame(near, currentAngle)
            lockedCFrame = cf
            isHover = hv
            if not lockedCFrame then C.busy = false return end

            local radius = getEggMaxRadius(near)
            C.status = string.format("捡: %s (半径%.1f, %s)",
                near.Name, radius, isHover and "悬空" or "地面")

            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = lockedCFrame
            if isHover then
                pcall(function() root.Anchored = true end)
            end

            local t0 = tick()
            while tick() - t0 < 0.3 do
                local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                if not h then break end
                if isHover then break end
                if h.FloorMaterial ~= Enum.Material.Air then break end
                task.wait(0.03)
            end
            task.wait(0.1)

            sendKeyDown(Enum.KeyCode.E)
            task.wait(C.tapTime)
            sendKeyUp(Enum.KeyCode.E)
            task.wait(C.tapWait)

            if not near.Parent then
                C.eggGot = C.eggGot + 1
                C.status = "✅ " .. near.Name
                clearAllLock()
                return
            end

            local function holdOnce(angleDeg, duration)
                if angleDeg then
                    currentAngle = angleDeg
                    local cf2, hv2 = computeStandCFrame(near, angleDeg)
                    lockedCFrame = cf2
                    isHover = hv2
                    if lockedCFrame then
                        local cc = player.Character
                        local rr = cc and cc:FindFirstChild("HumanoidRootPart")
                        if rr then
                            pcall(function() rr.Anchored = false end)
                            rr.AssemblyLinearVelocity = Vector3.zero
                            rr.AssemblyAngularVelocity = Vector3.zero
                            rr.CFrame = lockedCFrame
                            if isHover then
                                pcall(function() rr.Anchored = true end)
                            end
                        end
                    end
                    task.wait(0.1)
                end
                sendKeyDown(Enum.KeyCode.E)
                local t0 = tick()
                local timedOut = false
                while tick() - t0 < duration do
                    if not near.Parent then break end
                    if isTimeout() then timedOut = true break end
                    local c2 = player.Character
                    if not c2 then break end
                    local h2 = c2:FindFirstChildOfClass("Humanoid")
                    if not h2 or h2.Health <= 0 then break end
                    local r2 = c2:FindFirstChild("HumanoidRootPart")
                    if r2 and lockedCFrame then
                        local dx = r2.Position.X - lockedCFrame.Position.X
                        local dz = r2.Position.Z - lockedCFrame.Position.Z
                        if math.sqrt(dx*dx + dz*dz) > 30 then
                            timedOut = true
                            break
                        end
                    end
                    task.wait(0.05)
                end
                pcall(function()
                    sendKeyUp(Enum.KeyCode.E)
                end)
                return not timedOut
            end

            C.status = "长按: " .. near.Name
            local ok = holdOnce(nil, C.longHold)

            if near.Parent and ok and not isTimeout() then
                for _, ang in ipairs({90, 270, 180, 0}) do
                    if not near.Parent then break end
                    if isTimeout() then break end
                    C.status = "换方位 " .. ang .. "°: " .. near.Name
                    ok = holdOnce(ang, C.retryHold)
                    if not ok then break end
                end
            end

            if not near.Parent then
                C.eggGot = C.eggGot + 1
                C.status = "✅ " .. near.Name
            else
                if isTimeout() then
                    C.status = "⏱ 超时放弃: " .. near.Name
                else
                    C.status = "❌ " .. near.Name
                end
            end
            clearAllLock()
        end)
    end
end)

