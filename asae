local function shouldPull(npc)
    if not npc:IsA("Model") then return false end
    if npc == player.Character then return false end
    local hum = npc:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if npc:FindFirstChildOfClass("ForceField") then return false end
    return true
end

local function getAllNPCs()
    local list = {}
    if NPCFolder then
        for _, npc in ipairs(NPCFolder:GetChildren()) do
            if shouldPull(npc) then table.insert(list, npc) end
        end
    end
    if Mag.IncludePlayers and PlayerFolder then
        for _, npc in ipairs(PlayerFolder:GetChildren()) do
            if shouldPull(npc) and Players:GetPlayerFromCharacter(npc) ~= player then
                table.insert(list, npc)
            end
        end
    end
    return list
end

local lastTeleport = 0
RunService.Heartbeat:Connect(function(dt)
    if not C.magnetOn then return end
    if C.eggOn and C.busy then return end

    local char = player.Character
    if not char then return end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local front = myRoot.CFrame.LookVector
    front = Vector3.new(front.X, 0, front.Z)
    if front.Magnitude < 0.01 then front = Vector3.new(0, 0, -1) end
    front = front.Unit
    local targetPos = myRoot.Position + front * Mag.TargetDistance + Vector3.new(0, Mag.PullY, 0)
    for _, npc in ipairs(getAllNPCs()) do
        local hrp = npc:FindFirstChild("HumanoidRootPart")
        local hum = npc:FindFirstChildOfClass("Humanoid")
        if hrp and hum then
            local dist = (hrp.Position - myRoot.Position).Magnitude
            if dist <= Mag.Radius and dist > Mag.TargetDistance + 1 then
                if Mag.ZeroVelocity then
                    pcall(function()
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                if Mag.UseMoveTo then
                    pcall(function() hum:MoveTo(targetPos) end)
                end
                if tick() - lastTeleport >= Mag.TeleportRate then
                    local dir = targetPos - hrp.Position
                    local moveAmount = math.min(Mag.Speed * dt * 10, dir.Magnitude)
                    local newPos = hrp.Position + dir.Unit * moveAmount
                    pcall(function() hrp.CFrame = CFrame.new(newPos, newPos + front) end)
                end
            end
        end
    end
    if tick() - lastTeleport >= Mag.TeleportRate then
        lastTeleport = tick()
    end
end)

