-- 蛋透明化 + 穿透
-- ============================================================
local function setEggGhost(egg)
    if not egg then return end
    local parts = {}
    if egg:IsA("BasePart") then
        parts = {egg}
    elseif egg:IsA("Model") then
        for _, d in ipairs(egg:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(parts, d) end
        end
    end
    for _, p in ipairs(parts) do
        pcall(function()
            p.LocalTransparencyModifier = C.ghostAlpha
            p.CanCollide = false
            p.CanTouch = false
            p.CanQuery = false
            p.Massless = true
        end)
    end
end

local function restoreEgg(egg)
    if not egg then return end
    local parts = {}
    if egg:IsA("BasePart") then
        parts = {egg}
    elseif egg:IsA("Model") then
        for _, d in ipairs(egg:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(parts, d) end
        end
    end
    for _, p in ipairs(parts) do
        pcall(function()
            p.LocalTransparencyModifier = 0
            p.CanCollide = true
            p.CanTouch = true
            p.CanQuery = true
            p.Massless = false
        end)
    end
end

