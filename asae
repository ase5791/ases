local function isEgg(obj)
    if not obj then return false end
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
    local n = obj.Name:lower()
    return n:find("egg") or n:find("wolf") or n:find("pet")
end

local function gPos(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        return p and p.Position
    end
end

local function countEggs()
    if not GenFolder then return 0 end
    local n = 0
    for _, obj in ipairs(GenFolder:GetChildren()) do
        if isEgg(obj) then n = n + 1 end
    end
    return n
end

local function getEggMaxRadius(egg)
    local parts = {}
    if egg:IsA("BasePart") then parts = {egg}
    elseif egg:IsA("Model") then
        for _, d in ipairs(egg:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(parts, d) end
        end
    end
    if #parts == 0 then return 5, gPos(egg) end
    local sum = Vector3.zero
    for _, p in ipairs(parts) do sum = sum + p.Position end
    local center = sum / #parts
    local maxR = 0
    for _, p in ipairs(parts) do
        local d = (p.Position - center).Magnitude
        local s = p.Size
        local selfR = math.max(s.X, s.Y, s.Z) * 0.5
        if d + selfR > maxR then maxR = d + selfR end
    end
    return maxR, center
end

local function findGround(x, z, fromY, ignoreEgg)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {}
    local char = player.Character
    if char then table.insert(ignoreList, char) end
    if ignoreEgg then table.insert(ignoreList, ignoreEgg) end
    params.FilterDescendantsInstances = ignoreList

    local origin = Vector3.new(x, fromY + 5, z)
    local result = workspace:Raycast(origin, Vector3.new(0, -250, 0), params)
    if result then return result.Position.Y end
    return nil
end

local function computeStandCFrame(egg, angleDeg)
    local radius, center = getEggMaxRadius(egg)
    if not center then center = gPos(egg) end
    if not center then return nil, false end

    local ang = math.rad(angleDeg or 0)
    local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))

    local standX = center.X + dir.X * C.standHoriz
    local standZ = center.Z + dir.Z * C.standHoriz

    local groundY = findGround(standX, standZ, center.Y, egg)

    local standY, hover
    if groundY and groundY < center.Y + 5 then
        standY = groundY + C.groundOffset
        hover = false
    else
        standY = center.Y + C.standVert
        hover = true
    end

    local standPos = Vector3.new(standX, standY, standZ)
    local lookTarget = Vector3.new(center.X, standY, center.Z)
    return CFrame.lookAt(standPos, lookTarget), hover
end

local function getInitialAngle(egg)
    local center = select(2, getEggMaxRadius(egg)) or gPos(egg)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not center then return 0 end
    local delta = root.Position - center
    local hor = Vector3.new(delta.X, 0, delta.Z)
    if hor.Magnitude > 0.5 then
        return math.deg(math.atan2(hor.Z, hor.X))
    end
    return 0
end

local function isTimeout()
    return eggStartTime > 0 and (tick() - eggStartTime) >= C.eggTimeout
end

